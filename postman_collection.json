{
  "info": {
    "name": "TaskFlow Microservices - E2E (via API Gateway)",
    "description": "Flujo end-to-end de TaskFlow pasando SIEMPRE por el api-gateway (puerto 8080), nunca por el puerto directo de cada microservicio. Cubre: registro/login en user-service, CRUD de projects, CRUD de tasks y el endpoint de asignacion (caso exitoso y caso de usuario inexistente -> 400). El JWT devuelto por /login se guarda automaticamente en la variable de coleccion `token` via un test script, y las requests subsiguientes lo usan como Bearer token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "a1f7a5a0-1b1b-4e7a-9a39-taskflow0001"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080", "type": "string" },
    { "key": "email", "value": "ada@taskflow.dev", "type": "string" },
    { "key": "password", "value": "secret123", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "userId", "value": "", "type": "string" },
    { "key": "projectId", "value": "", "type": "string" },
    { "key": "taskId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "01 - Auth",
      "item": [
        {
          "name": "Register user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// El registro puede dar 201 (primera corrida) o 409/400 si ya existe (reruns).",
                  "pm.test('status is 201 or already-exists', function () {",
                  "    pm.expect([201, 400, 409]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "    var body = pm.response.json();",
                  "    pm.collectionVariables.set('userId', String(body.id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/users/register",
              "host": ["{{base_url}}"],
              "path": ["api", "users", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ada Lovelace\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          }
        },
        {
          "name": "Login (guarda el token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login succeeds with 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var body = pm.response.json();",
                  "pm.test('response has token', function () {",
                  "    pm.expect(body.token).to.be.a('string');",
                  "});",
                  "pm.collectionVariables.set('token', body.token);",
                  "if (body.user && body.user.id) {",
                  "    pm.collectionVariables.set('userId', String(body.user.id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/users/login",
              "host": ["{{base_url}}"],
              "path": ["api", "users", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          }
        },
        {
          "name": "Get user by id (valida el id guardado)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/users/{{userId}}",
              "host": ["{{base_url}}"],
              "path": ["api", "users", "{{userId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "02 - Projects",
      "item": [
        {
          "name": "Create project (guarda projectId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var body = pm.response.json();",
                  "pm.collectionVariables.set('projectId', String(body.id));",
                  "pm.test('ownerId viene del JWT, no del body', function () {",
                  "    pm.expect(String(body.ownerId)).to.eql(pm.collectionVariables.get('userId'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/projects",
              "host": ["{{base_url}}"],
              "path": ["api", "projects"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"TaskFlow\",\n  \"description\": \"Proyecto de portafolio\"\n}"
            }
          }
        },
        {
          "name": "Get project by id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/projects/{{projectId}}",
              "host": ["{{base_url}}"],
              "path": ["api", "projects", "{{projectId}}"]
            }
          }
        },
        {
          "name": "List projects by owner",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('la lista incluye el projectId creado', function () {",
                  "    var ids = pm.response.json().map(function (p) { return String(p.id); });",
                  "    pm.expect(ids).to.include(pm.collectionVariables.get('projectId'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/projects?ownerId={{userId}}",
              "host": ["{{base_url}}"],
              "path": ["api", "projects"],
              "query": [{ "key": "ownerId", "value": "{{userId}}" }]
            }
          }
        },
        {
          "name": "Update project (solo el dueno puede)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('description quedo actualizada', function () {",
                  "    pm.expect(pm.response.json().description).to.eql('Actualizado desde Postman');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/projects/{{projectId}}",
              "host": ["{{base_url}}"],
              "path": ["api", "projects", "{{projectId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"TaskFlow\",\n  \"description\": \"Actualizado desde Postman\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "03 - Tasks",
      "item": [
        {
          "name": "Create task (guarda taskId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var body = pm.response.json();",
                  "pm.collectionVariables.set('taskId', String(body.id));",
                  "pm.test('la tarea nace en TODO', function () {",
                  "    pm.expect(body.status).to.eql('TODO');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/tasks",
              "host": ["{{base_url}}"],
              "path": ["api", "tasks"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Disenar el gateway\",\n  \"projectId\": {{projectId}}\n}"
            }
          }
        },
        {
          "name": "Get task by id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/tasks/{{taskId}}",
              "host": ["{{base_url}}"],
              "path": ["api", "tasks", "{{taskId}}"]
            }
          }
        },
        {
          "name": "List tasks by project",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('la lista incluye el taskId creado', function () {",
                  "    var ids = pm.response.json().map(function (t) { return String(t.id); });",
                  "    pm.expect(ids).to.include(pm.collectionVariables.get('taskId'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/tasks?projectId={{projectId}}",
              "host": ["{{base_url}}"],
              "path": ["api", "tasks"],
              "query": [{ "key": "projectId", "value": "{{projectId}}" }]
            }
          }
        },
        {
          "name": "Assign task to existing user (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('assigneeId quedo seteado', function () {",
                  "    pm.expect(String(pm.response.json().assigneeId)).to.eql(pm.collectionVariables.get('userId'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/tasks/{{taskId}}/assign",
              "host": ["{{base_url}}"],
              "path": ["api", "tasks", "{{taskId}}", "assign"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assigneeId\": {{userId}}\n}"
            }
          }
        },
        {
          "name": "Assign task to nonexistent user (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400 - task-service valido contra user-service', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test('no se persiste el cambio (mensaje de error)', function () {",
                  "    pm.expect(pm.response.json().message).to.include('999999');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/tasks/{{taskId}}/assign",
              "host": ["{{base_url}}"],
              "path": ["api", "tasks", "{{taskId}}", "assign"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assigneeId\": 999999\n}"
            }
          }
        },
        {
          "name": "Update task status to IN_PROGRESS",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('el estado cambio a IN_PROGRESS', function () {",
                  "    pm.expect(pm.response.json().status).to.eql('IN_PROGRESS');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/tasks/{{taskId}}/status",
              "host": ["{{base_url}}"],
              "path": ["api", "tasks", "{{taskId}}", "status"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_PROGRESS\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "04 - Cleanup",
      "item": [
        {
          "name": "Delete project (solo el dueno puede)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 204', function () {",
                  "    pm.response.to.have.status(204);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/projects/{{projectId}}",
              "host": ["{{base_url}}"],
              "path": ["api", "projects", "{{projectId}}"]
            }
          }
        }
      ]
    }
  ]
}
